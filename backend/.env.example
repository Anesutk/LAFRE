# Copy to .env for local development. Do not commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-locally
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Harare

# Frontend / CORS
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL is the default now.
# Option A: one URL, same format Render uses:
DATABASE_URL=postgres://lafre:lafre_password@127.0.0.1:5432/lafre_dev

# Option B: leave DATABASE_URL blank and use parts below:
POSTGRES_DB=lafre_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Emergency offline test only, not production:
# LAFRE_ALLOW_SQLITE=1

# AWS / Bedrock / Knowledge Base. Keep blank until configured.
AWS_REGION=us-east-1
AWS_KB_ID=
AWS_BEDROCK_MODEL_ID=
BEDROCK_FAST_MODEL_ID=
BEDROCK_SMART_MODEL_ID=
# Optional: model used only to pick which answer-shape tool to use (intent routing).
# Defaults to BEDROCK_FAST_MODEL_ID (or nova-micro) if unset - keep this cheap/fast, it never
# writes the actual answer.
BEDROCK_ROUTER_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PRESIGNED_URL_EXPIRY_SECONDS=900

# Email / password reset links
DEFAULT_FROM_EMAIL=no-reply@lafre.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
